      - name: dpe
        data_type: varchar(1)

      - name: date_dpe
        data_type: date

      - name: nges
        data_type: integer

      - name: adresse_id
        data_type: varchar(14)


corrected AS (
    SELECT

        CAST(numero_dpe AS VARCHAR(13)) AS numero_dpe,
        CAST(fraisannuelsenergie AS FLOAT) AS fraisannuelsenergie,
        CAST(ges AS VARCHAR(1)) AS ges,
        CAST(dpe AS VARCHAR(1)) AS dpe,
        CAST(date_dpe AS DATE) AS date_dpe,
        CAST(nges AS INTEGER) AS nges,
        CAST(adresse_id AS VARCHAR(14)) AS adresse_id
    FROM deduplicated
)

SELECT *
FROM corrected
    ) as __dbt_sbq
    where false
    limit 0


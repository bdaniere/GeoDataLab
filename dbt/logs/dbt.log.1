      id, code_insee, nom, nom_unaccent, code_postal, superficie, population, epci, epci_id, geom
    )
  
  (
    
    select id, code_insee, nom, nom_unaccent, code_postal, superficie, population, epci, epci_id, geom
    from (
        


WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."imope_commune"
),


filtered AS (
    SELECT *
    FROM source_data
    WHERE geometry IS NOT NULL
      AND NOT ST_IsEmpty(geometry)
),

    -- -- Exclusion des arrondissements pour ne conserver que les communes principales
    -- deduplicated AS (
    --     SELECT DISTINCT ON (insee) *
    --     FROM filtered
    --     ORDER BY insee, ST_Area(geometry) DESC
    -- ),



corrected AS (
    SELECT
        CAST(id AS VARCHAR(9)) AS id,
        CAST(insee AS VARCHAR(5)) AS code_insee,
        nom,
        nom_unaccent,
        CAST(cp AS VARCHAR(5)) AS code_postal,
        CAST(superficie AS FLOAT) AS superficie,
        CAST(population AS INTEGER) AS population,
        CAST(epci_id AS VARCHAR(9)) AS epci_id,
        CAST(epci AS VARCHAR(9)) AS epci,
        CAST(
            ST_Transform(
                ST_Multi(
                    CASE
                        WHEN ST_IsValid(geometry) THEN geometry
                        ELSE ST_CollectionExtract(ST_MakeValid(geometry), 3)
                    END
                ),

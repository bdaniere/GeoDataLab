WITH source_data AS (
    SELECT
        id,
        adresse,
        commune,
        iris,
        nlogh,
        cp,
        altitude,
        bailleursoc,
        batihist,
        chauffage,
        consochauff,
        consochurb,
        consoelec,
        consoelecm,

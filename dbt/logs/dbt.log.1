    typobati varchar(22),
    zoneargile varchar(6),
    zonehist boolean,
    zoneinond boolean,
    zoneqpv boolean,
    zonezsp boolean,
    pmr varchar(2),
    commune_id varchar(5),
    epci_id varchar(9),
    iris_id varchar(9),
    parcelle_id varchar(14),

WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."imope_commune"
),

filtered AS (
    SELECT *
    FROM source_data
    WHERE geometry IS NOT NULL
      AND NOT ST_IsEmpty(geometry)
),

deduplicated AS (
    SELECT DISTINCT ON (insee) *
    FROM filtered
    ORDER BY insee, superficie DESC NULLS LAST
),

corrected AS (
    SELECT
        CAST(insee AS VARCHAR(5)) AS code_insee,
        nom,
        nom_unaccent,
        CAST(cp AS VARCHAR(5)) AS cp,
        CAST(superficie AS FLOAT) AS superficie,
        CAST(population AS INTEGER) AS population,
        CAST(epci_id AS VARCHAR(9)) AS epci_id,
        CAST(epci AS VARCHAR(9)) AS epci,
        CAST(
            ST_Transform(
                ST_Multi(
                    CASE
                        WHEN ST_IsValid(geometry) THEN geometry
                        ELSE ST_CollectionExtract(ST_MakeValid(geometry), 3)
                    END
                ),
                2154
            ) AS geometry(MULTIPOLYGON, 2154)
        ) AS geom

    FROM deduplicated
)

SELECT *
FROM corrected
    ) as __dbt_sbq
    where false
    limit 0


  create  table "GeoDataLab"."staging"."batiments__dbt_tmp"
  
  
    
  
  (
    id uuid not null,
    type varchar(2),
    nom text,
    code_insee varchar(5),
    created_at TIMESTAMP,
    updated_at TIMESTAMP,
    geom geometry(MultiPolygon,2154),
    
    primary key (id),
    foreign key (code_insee) references "GeoDataLab"."staging"."communes" (code_insee)
    )
 ;
    insert into "GeoDataLab"."staging"."batiments__dbt_tmp" (
      id, type, nom, code_insee, created_at, updated_at, geom
    )
  
  (
    
    select id, type, nom, code_insee, created_at, updated_at, geom
    from (
        


WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."batiments"
),

filtered AS (
    SELECT *
    FROM source_data
    WHERE geometry IS NOT NULL
      AND NOT ST_IsEmpty(geometry)
),

deduplicated AS (
    SELECT DISTINCT ON (geometry) *
    FROM filtered
    ORDER BY
        geometry,
        created DESC NULLS LAST
),

corrected AS (
    SELECT
        gen_random_uuid() AS id,
        CAST(type AS VARCHAR(2)) AS type,
        nom,
        CAST(commune AS VARCHAR(5)) AS code_insee,
        created AS created_at,
        updated AS updated_at,
        CAST(
            ST_Transform(
                ST_Multi(
                    CASE
                        WHEN ST_IsValid(geometry) THEN geometry
                        ELSE ST_CollectionExtract(ST_MakeValid(geometry), 3)
                    END
                ),
                2154
            ) AS geometry(MULTIPOLYGON, 2154)
        ) AS geom

    FROM deduplicated
)

SELECT *
FROM corrected
    ) as model_subq
  );
  

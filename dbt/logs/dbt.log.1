  create  table "GeoDataLab"."staging"."communes_france__dbt_tmp"
  
  
    as
  
  (
    


WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."communes_france"
),

corrected AS (
    SELECT
        code AS code_insee,
        nom,
        departement,
        region,
        commune,
        plm,
        epci,
        CAST(
            CASE
                WHEN geometry IS NULL THEN NULL

                WHEN ST_IsValid(geometry) THEN geometry

                ELSE ST_CollectionExtract(
                    ST_MakeValid(geometry),
                    3
                )
            END AS geometry(MULTIPOLYGON, 2154)
        ) AS geom

    FROM source_data

)

SELECT *
FROM corrected
WHERE departement = '69'



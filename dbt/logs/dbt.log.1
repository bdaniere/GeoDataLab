    surfaceplanchershauts,
    surfacetot,
    toit,
    typehab,
    typobati,
    zoneargile,
    zonehist,
    zoneinond,
    zoneqpv,
    zonezsp,
    pmr,
    code_insee,
    epci_id,
    iris_id,
    parcelle_id,
    geometry
FROM corrected
    ) as __dbt_sbq
    where false
    limit 0


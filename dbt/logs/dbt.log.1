  create  table "GeoDataLab"."staging"."communes__dbt_tmp"
  
  
    as
  
  (
    


WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."communes_france"
),

corrected AS (
    SELECT
        CAST(code AS VARCHAR(5)) AS code_insee,
        nom,
        CAST(departement AS VARCHAR(3)) AS departement,
        CAST(region AS VARCHAR(3)) AS region,
        commune,
        plm,
        epci,
        CAST(
            CASE
                WHEN geometry IS NULL THEN NULL

                WHEN ST_IsValid(geometry) THEN geometry

                ELSE ST_CollectionExtract(
                    ST_MakeValid(geometry),
                    3
                )
            END AS geometry(MULTIPOLYGON, 2154)
        ) AS geom

    FROM source_data

)

SELECT *
FROM corrected
WHERE departement = '69'


-- impossible de renommer la colonne geometry en geom : a voir 
-- la colonne n'a visiblement pas de SRID : voir comment préciser 
-- Il faudra également voir pour indiquer un PK , ... 

-- récupération du département ailleur (au lieu de l'écrire en dur ici)
  );
  

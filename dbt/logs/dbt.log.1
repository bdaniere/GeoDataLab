-- TO DO : filtre géométrique pour ne pas concerver les données pour l'ensemble de la france ! 

WITH corrected AS (

    SELECT
        code AS code_insee,
        nom,
        departement,
        region,
        commune,
        plm,
        epci,


        CASE
            WHEN geometry IS NULL THEN NULL

            WHEN ST_IsValid(geometry) THEN geometry

            ELSE ST_CollectionExtract(
                ST_MakeValid(geometry),
                3
            )
        END AS geom

    FROM "GeoDataLab"."raw_data"."communes_france"

)

SELECT *
FROM corrected
WHERE departement = '69'
  );
  

    foreign key (adresse_id) references "GeoDataLab"."staging"."adresses" (id)
    )
 ;
    insert into "GeoDataLab"."staging"."dpe__dbt_tmp" (
      numero_dpe, fraisannuelsenergie, ges, dpe, date_dpe, nges, adresse_id
    )
  
  (
    
    select numero_dpe, fraisannuelsenergie, ges, dpe, date_dpe, nges, adresse_id
    from (
        


WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."imope_adresse"
),

filtered AS (
    SELECT *
    FROM source_data
    WHERE numero_dpe IS NOT NULL
),

deduplicated AS (
    SELECT DISTINCT ON (numero_dpe) *
    FROM filtered
    ORDER BY
        numero_dpe DESC NULLS LAST
),

corrected AS (
    SELECT

        CAST(numero_dpe AS VARCHAR(13)) AS numero_dpe,
        CAST(fraisannuelsenergie AS FLOAT) AS fraisannuelsenergie,
        CAST(ges AS VARCHAR(1)) AS ges,
        CAST(dpe AS VARCHAR(1)) AS dpe,
        CAST(date_dpe AS DATE) AS date_dpe,
        CAST(nges AS INTEGER) AS nges,
        CAST(id AS TEXT) AS adresse_id
    FROM deduplicated
)

SELECT *
FROM corrected
    ) as model_subq
  );
  

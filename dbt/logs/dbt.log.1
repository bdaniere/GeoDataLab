 ;
    insert into "GeoDataLab"."staging"."communes_france__dbt_tmp" (
      code_insee, nom, departement, region, commune, plm, epci, geom
    )
  
  (
    
    select code_insee, nom, departement, region, commune, plm, epci, geom
    from (
        


WITH source_data AS (
    SELECT * FROM "GeoDataLab"."raw_data"."communes_france"
),

filtered AS (
    SELECT *
    FROM source_data
    WHERE geometry IS NOT NULL
      AND NOT ST_IsEmpty(geometry)
),

deduplicated AS (
    SELECT DISTINCT ON (geometry) *
    FROM filtered
    ORDER BY geometry, code
),

corrected AS (

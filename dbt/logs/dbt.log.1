  (
    
    select id, adresse, commune, iris, nlogh, cp, altitude, bailleursoc, batihist, chauffage, consochauff, consochurb, consoelec, consoelecm, consogaz, consogazm, consotou, consotoum, consochurbm, diffprixpct, energie, mur, nbpdlelec, nbpdlgaz, nivtot, nlogsoc, pgaz, prix, surfacemurs, surfaceplanchersbas, surfaceplanchershauts, surfacetot, toit, typehab, typobati, zoneargile, zonehist, zoneinond, zoneqpv, zonezsp, pmr, commune_id, epci_id, iris_id, parcelle_id, geometry
    from (
        

WITH source_data AS (
    SELECT
        id,
        adresse,
        commune,
        iris,
        nlogh,
        cp,
        altitude,
        bailleursoc,
        batihist,
        chauffage,
        consochauff,
        consochurb,
        consoelec,
        consoelecm,
        consogaz,
        consogazm,
        consotou,
        consotoum,

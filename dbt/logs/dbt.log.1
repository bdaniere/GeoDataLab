    WHERE geometry IS NOT NULL
      AND NOT ST_IsEmpty(geometry)
),

deduplicated AS (
    SELECT DISTINCT ON (insee) *
    FROM filtered
    ORDER BY insee, ST_Area(geometry) DESC
),



corrected AS (
    SELECT
        CAST(insee AS VARCHAR(5)) AS code_insee,
        nom,
        nom_unaccent,
        CAST(cp AS VARCHAR(5)) AS code_postal,

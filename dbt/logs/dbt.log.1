    toit,
    typehab,
    typobati,
    zoneargile,
    zonehist,
    zoneinond,
    zoneqpv,
    zonezsp,
    pmr,
    commune_id,
    epci_id,
    iris_id,
    parcelle_id,
    geometry
FROM corrected
    ) as model_subq
  );
  

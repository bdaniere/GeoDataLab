		execution-cost="100"
		row-amount="0">
	<schema name="staging"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[    BEGIN
        NEW.updated_at = statement_timestamp();
        NEW.updated_by = CURRENT_USER;
        RETURN NEW;
    END;
    ]]> </definition>
</function>


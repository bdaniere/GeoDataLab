<function name="event_trigger_function_for_metadata"
		window-func="false"
		returns-setof="false"
		behavior-type="CALLED ON NULL INPUT"
		function-type="VOLATILE"
		security-type="SECURITY INVOKER"
		parallel-type="PARALLEL UNSAFE"
		execution-cost="100"
		row-amount="0">
	<schema name="ogr_system_tables"/>
	<role name="postgres"/>
	<language name="plpgsql"/>
	<return-type>
	<type name="event_trigger" length="0"/>
	</return-type>
	<definition> <![CDATA[DECLARE
    obj record;
BEGIN
  IF has_schema_privilege('ogr_system_tables', 'USAGE') THEN
   IF has_table_privilege('ogr_system_tables.metadata', 'DELETE') THEN
    FOR obj IN SELECT * FROM pg_event_trigger_dropped_objects()
    LOOP
        IF obj.object_type = 'table' THEN
            DELETE FROM ogr_system_tables.metadata m WHERE m.schema_name = obj.schema_name AND m.table_name = obj.object_name;
        END IF;
    END LOOP;
   END IF;
  END IF;
END;]]> </definition>
</function>

<eventtrigger name="ogr_system_tables_event_trigger_for_metadata" event="sql_drop">
	<role name="postgres"/>
	<function signature="ogr_system_tables.event_trigger_function_for_metadata()"/>
	<filter variable="TAG" values=""/>
</eventtrigger>

